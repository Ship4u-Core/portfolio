# Copy to .env and replace re_xxxxxxxxx with your Resend API key.
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives form submissions.
ENQUIRY_TO=contact@ship4u.in

# Must be on a verified Resend domain in production (https://resend.com/domains).
# onboarding@resend.dev is test-only and can only send to the Resend account email.
RESEND_FROM=Ship4u <onboarding@resend.dev>
